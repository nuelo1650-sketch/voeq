    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "@voeq/eslint-config": "workspace:*",
    "@voeq/tsconfig": "workspace:*",
    "@types/node": "^20.14.13",
    "eslint": "^8.57.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
