auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
; Default virtual store (inside node_modules/.pnpm) — no custom path.
; Force hardlinks, not copy: copy import drops files (e.g. next's ./impl) and
; next's build then breaks on the 2nd run. hard-link-max high = allow hardlinks.
package-import-method=hardlink
hard-link-max=1000000
virtual-store-dir=node_modules/.pnpm
store-dir=~/.pnpm-store
