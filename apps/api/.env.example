# Database
DATABASE_URL="postgresql://user:***@host:5432/voeq?sslmode=require"
DIRECT_URL="postgresql://user:***@host:5432/voeq?sslmode=require"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_CLIENT_ID="from-google-cloud-console"
AUTH_GOOGLE_CLIENT_SECRET="from-google-cloud-console"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="from-resend-com"
RESEND_FROM_EMAIL="noreply@voeq.ng"
ADMIN_EMAIL="admin@voeq.ng"

# Logging
LOG_LEVEL="info"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Sightengine
SIGHTENGINE_USER=""
SIGHTENGINE_SECRET=""

# Admin / Impersonation
IMPERSONATION_SECRET=""

# Error Tracking
SENTRY_DSN=""

# Rate Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Bot Protection
TURNSTILE_SECRET_KEY=""

# Backup
BACKUP_CLOUDINARY_FOLDER="voeq-backups"
BACKUP_RETENTION_DAYS="30"
