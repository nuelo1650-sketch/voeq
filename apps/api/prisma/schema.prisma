// Voeq — Multi-University Campus Marketplace
// Database schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  buyer
  vendor
  moderator
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
  banned
}

enum AuthProvider {
  google
  email
}

enum InstitutionType {
  university
  polytechnic
  college
  other
}

enum InstitutionSource {
  seed
  user_submitted
}

enum InstitutionStatus {
  pending
  approved
  rejected
}

enum VendorStatus {
  incomplete
  pending_review
  live
  suspended
}

enum ListingStatus {
  draft
  active
  paused
  archived
}

enum ReviewStatus {
  visible
  hidden
  deleted
}

enum ReportCategory {
  not_on_campus
  scam_or_fraud
  inappropriate_content
  impersonation
  harassment
  other
}

enum ReportStatus {
  open
  investigating
  resolved
  dismissed
}

enum BadgeKey {
  newcomer
  active_seller
  verified_presence
  quick_responder
  rising_star
  top_rated
  multi_talented
  community_pillar
}

enum EventType {
  page_view
  search
  category_filter
  listing_view
  vendor_view
  whatsapp_click
  signup_started
  signup_completed
  vendor_go_live
  listing_created
  review_submitted
  report_submitted
  request_submitted
  badge_earned
}

enum AuthTokenType {
  otp
  magic_link
}

enum AuthTokenPurpose {
  signin
  password_reset
}

// ============================================================================
// USERS & AUTH
// ============================================================================

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  name                String?
  image               String?
  role                UserRole    @default(buyer)
  status              UserStatus  @default(active)
  defaultCampusId     String?
  emailVerified       DateTime?
  hasPassword         Boolean     @default(false)
  hasGoogle           Boolean     @default(false)
  passwordHash        String?
  lastSignInAt        DateTime?
  agreementVersion    String?
  agreementAcceptedAt DateTime?
  agreementIp         String?
  agreementUserAgent  String?
  homeSeenAt          DateTime?  // set after a shopper finishes the one-time in-app welcome wizard
  lastAdminImpersonationAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  drafts Json?

  defaultCampus    Campus?        @relation("UserDefaultCampus", fields: [defaultCampusId], references: [id])
  vendor           Vendor?
  reviews          Review[]
  reportsSubmitted Report[]       @relation("ReportSubmitter")
  sessions         Session[]
  auditLogs        AuditLog[]
  events           EventLog[]
  wishlistItems    WishlistItem[]
  following        Follow[]
  preference       UserPreference?
  reviewComments   ReviewComment[]
  reviewLikes      ReviewLike[]
  disputesFiled    Dispute[] @relation("DisputeReporter")

  @@index([email])
  @@index([role])
  @@index([defaultCampusId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  impersonatedBy String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// AUTH TOKENS (OTP + Magic Link storage)
// ============================================================================

model AuthToken {
  id         String             @id @default(cuid())
  email      String
  tokenHash  String             @unique
  type       AuthTokenType
  purpose    AuthTokenPurpose?
  userId     String?
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime           @default(now())

  @@index([email, type])
  @@index([expiresAt])
}

// ============================================================================
// INSTITUTIONS & CAMPUSES
// ============================================================================

model Institution {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  type       InstitutionType   @default(university)
  logoUrl    String?
  city       String?
  state      String?
  country    String            @default("Nigeria")
  source     InstitutionSource @default(seed)
  status     InstitutionStatus @default(approved)
  isVerified Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  approvedAt DateTime?
  approvedBy String?

  requestedByEmail String?

  campuses Campus[]
  vendors  Vendor[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@index([name])
}

model Campus {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  slug          String
  isPrimary     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vendors          Vendor[]
  defaultCampusFor User[]      @relation("UserDefaultCampus")

  @@unique([institutionId, slug])
  @@index([institutionId])
}

// ============================================================================
// VENDORS & LISTINGS
// ============================================================================

model Vendor {
  id                   String       @id @default(cuid())
  userId               String       @unique
  businessName         String
  businessSlug         String       @unique
  ownerName            String
  description          String
  profilePhotoPublicId String?
  whatsappNumber       String
  publicPhone          String?
  institutionId        String?
  campusId             String?
  city                 String?
  state                String?
  status               VendorStatus @default(incomplete)
  agreementVersion     String?
  agreementAcceptedAt  DateTime?
  agreementIp          String?
  agreementUserAgent   String?
  verifiedBadge        Boolean      @default(false)
  verifiedAt           DateTime?
  verifiedBy           String?
  isFeatured           Boolean      @default(false)
  featuredUntil        DateTime?
  featuredBy           String?
  trustScore           Int          @default(50)
  whatsappClickCount   Int          @default(0)
  viewCount            Int          @default(0)
  ratingAvg            Float        @default(0)
  ratingCount          Int          @default(0)
  isFlashDealActive    Boolean      @default(false)
  flashDealUntil       DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?

  onboardingProgress  Int          @default(0)
  lastDraftSavedAt    DateTime?

  // Operating hours
  operatingHours Json?
  isAlwaysOpen   Boolean @default(false)
  timezone       String? @default("Africa/Lagos")

  // Social media handles
  instagramHandle  String?
  tiktokHandle     String?
  twitterHandle    String?
  facebookPage     String?
  linkedinProfile  String?
  websiteUrl       String?

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution?  @relation(fields: [institutionId], references: [id])
  campus      Campus?       @relation(fields: [campusId], references: [id])
  listings    Listing[]
  reviews     Review[]
  reports     Report[]      @relation("ReportTarget")
  badges      VendorBadge[]
  events      EventLog[]
  wishlistItems WishlistItem[]
  followers   Follow[]
  disputes    Dispute[] @relation("DisputeVendor")

  @@index([businessSlug])
  @@index([status])
  @@index([institutionId])
  @@index([campusId])
  @@index([isFeatured, featuredUntil])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
  searchVector Unsupported("tsvector")?
}

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?
  iconName      String?
  imagePublicId String?
  imageUrl      String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  isOfficial    Boolean  @default(false)
  createdById   String?
  parentCategoryId String?
  parentCategory Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id])
  childCategories Category[] @relation("CategoryTree")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listings Listing[]
  listingCategories ListingCategory[]

  @@index([isActive, displayOrder])
  @@index([slug])
  @@index([parentCategoryId])
}

model Listing {
  id                 String        @id @default(cuid())
  vendorId           String
  categoryId         String?
  title              String
  slug               String
  description        String
  priceMin           Decimal       @db.Decimal(12, 2)
  priceMax           Decimal?      @db.Decimal(12, 2)
  currency           String        @default("NGN")
  section            String?
  status             ListingStatus @default(draft)
  viewCount          Int           @default(0)
  whatsappClickCount Int           @default(0)
  isFlashDeal        Boolean       @default(false)
  flashDealUntil     DateTime?
  approvedAt         DateTime?
  approvedBy         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  vendor   Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [categoryId], references: [id])
  categories ListingCategory[]
  photos   ListingPhoto[]
  reviews  Review[]
  events   EventLog[]
  disputes Dispute[]
  wishlistItems WishlistItem[]

  @@unique([vendorId, slug])
  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([isFlashDeal, flashDealUntil])
  searchVector Unsupported("tsvector")?
}

model ListingCategory {
  id         String   @id @default(cuid())
  listingId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  listing  Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([listingId, categoryId])
  @@index([categoryId])
  @@index([listingId])
}

model ListingPhoto {
  id           String   @id @default(cuid())
  listingId    String
  publicId     String
  url          String
  width        Int
  height       Int
  displayOrder Int      @default(0)
  altText      String?
  createdAt    DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// ============================================================================
// SOCIAL PROOF
// ============================================================================

model Review {
  id                 String       @id @default(cuid())
  vendorId           String
  userId             String
  listingId          String?
  rating             Int
  text               String
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(visible)
  vendorResponse     String?
  vendorRespondedAt  DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vendor  Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  comments ReviewComment[]
  likes    ReviewLike[]

  @@unique([userId, vendorId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

model VendorBadge {
  id            String    @id @default(cuid())
  vendorId      String
  badgeKey      BadgeKey
  earnedAt      DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, badgeKey])
  @@index([vendorId])
  @@index([badgeKey])
}

// ============================================================================
// REQUESTS & REPORTS
// ============================================================================

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  emailMarketing      Boolean  @default(true)
  emailReviews        Boolean  @default(true)
  emailNewsletter     Boolean  @default(true)
  notifyNewListings   Boolean  @default(true)
  notifyNewReviews    Boolean  @default(true)
  notifyNewFollowers  Boolean  @default(true)
  notifyDisputes      Boolean  @default(true)
  feedPrefsSetAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dispute {
  id          String   @id @default(cuid())
  reporterId  String
  vendorId    String
  listingId   String?
  reason      String
  details     String?
  status      String   @default("open")
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User    @relation("DisputeReporter", fields: [reporterId], references: [id])
  vendor   Vendor  @relation("DisputeVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([vendorId])
  @@index([reporterId])
  @@index([createdAt])
}

model ReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([authorId])
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model Report {
  id          String         @id @default(cuid())
  submitterId String
  targetId    String
  category    ReportCategory
  text        String?
  status      ReportStatus   @default(open)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  submitter User   @relation("ReportSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  target    Vendor @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetId])
  @@index([submitterId])
  @@index([createdAt])
}

// ============================================================================
// AGREEMENTS
// ============================================================================

model Agreement {
  id          String   @id @default(cuid())
  type        String
  version     String
  title       String
  content     String
  effectiveAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, version])
  @@index([type, effectiveAt])
}

// ============================================================================
// ANALYTICS
// ============================================================================

model EventLog {
  id         String    @id @default(cuid())
  eventType  EventType
  userId     String?
  sessionId  String?
  vendorId   String?
  listingId  String?
  categoryId String?
  campusId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId])
  @@index([vendorId, createdAt])
  @@index([listingId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

// ============================================================================
// SYSTEM
// ============================================================================

model FeatureFlag {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String?
  listingId String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor  Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Exactly one of vendorId / listingId is set. The two partial uniques
  // never overlap (one row has vendorId set + listingId null, the other
  // has vendorId null + listingId set) so a user can't double-save.
  @@unique([userId, vendorId])
  @@unique([userId, listingId])
  @@index([userId])
  @@index([vendorId])
  @@index([listingId])
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

model PressItem {
  id          String   @id @default(cuid())
  kind        String   @default("announcement") // announcement | feature | press-release | blog
  title       String
  summary     String?
  body        String?
  publishDate DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([publishDate])
}
