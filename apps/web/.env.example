# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Backend API
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Database (used by future Prisma client — placeholder for now)
DATABASE_URL="postgresql://user:password@host:5432/voeq?sslmode=require"

# Auth (NextAuth)
AUTH_SECRET="same-value-as-backend"
AUTH_GOOGLE_CLIENT_ID="same-value-as-backend"
AUTH_GOOGLE_CLIENT_SECRET="same-value-as-backend"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Backend
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Resend (not used on frontend, but NextAuth may need it)
RESEND_FROM_EMAIL="onboarding@resend.dev"
