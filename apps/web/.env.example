# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Backend API
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Database
DATABASE_URL="postgresql://user:***@host:5432/voeq?sslmode=require"

# Auth
AUTH_SECRET="same-value-as-backend"
AUTH_GOOGLE_CLIENT_ID="same-value-as-backend"
AUTH_GOOGLE_CLIENT_SECRET="same-value-as-backend"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Error Tracking
NEXT_PUBLIC_SENTRY_DSN=""

# Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Business WhatsApp (footer contact link). E.164 format, e.g. 2348012345678.
# Leave empty to hide the footer WhatsApp link.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
